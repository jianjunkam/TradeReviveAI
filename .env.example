APP_SECRET=change-me
# development serves plain http; anything else marks the session cookie Secure
ENVIRONMENT=development
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/traderevive_ai
# Model provider (never commit real keys)
DEEPSEEK_API_KEY=
# AI: the journal's "AI analysis" section. One model call, server-side, key never sent to
# the browser. Without a key it falls back to the Flowise chatflow below; set both empty to
# show "no model configured" instead.
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com
FLOWISE_HOST=flowise.bdctraining.cloud
FLOWISE_CHATFLOW_ID=f2ac3baa-63d0-4ce2-ba69-07d8fa7b66c8
ANTHROPIC_API_KEY=
# Sign-in, messages and billing
EMAIL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Demo pages are OPEN unless you close them. PUBLIC_DASHBOARD is retired: it was read as a
# gate, and a stale PUBLIC_DASHBOARD=false in a deployed .env hid the whole site.
#DEMO_CLOSED=true
# No login page: every visitor is the one demo account, and /sign-in goes to /app.
# Set true to put the sign-in flow back in front of /app.
REQUIRE_SIGN_IN=false
# Include your broker account's OPEN POSITIONS in /api/public/market.
# Off by default; only enable it on a host you control.
#PUBLIC_POSITIONS=false
DEMO_WATCHLIST=US.AAPL,HK.00700

# Market dashboard: how often the US market is re-read, and how many stocks it lists.
MARKET_REFRESH_SECONDS=30
MARKET_TOP_N=100

# Paper trading: simulated cash, stored in a local JSON file (gitignored).
PAPER_STARTING_CASH=100000
PAPER_STORE_PATH=data/paper.json

OPEND_MARKET=MY
OPEND_TRADE_MARKET=US
OPEND_TRADE_ENV=SIMULATE

# -+ market data
# Yahoo Finance over HTTPS: no account, no gateway to install.
YAHOO_TIMEOUT=12
